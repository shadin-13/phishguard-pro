{
  "manifest_version": 3,
  "name": "PhishGuard Pro - URL Threat Checker",
  "version": "1.0.0",
  "description": "Check the current page URL for phishing threats using PhishGuard Pro API",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {}
}
